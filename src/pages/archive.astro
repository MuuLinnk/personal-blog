---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

function formatDate(d: Date | string) {
  const date = d instanceof Date ? d : new Date(d);
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const dd = String(date.getDate()).padStart(2, '0');
  return `${y}-${m}-${dd}`;
}

const allPosts = await getCollection('posts');

interface PostMeta {
  title: string;
  slug: string;
  date: Date;
  tags: string[];
}

const posts: PostMeta[] = allPosts
  .map((post) => ({
    title: post.data.title,
    slug: post.data.slug || post.id,
    date: post.data.date instanceof Date ? post.data.date : new Date(post.data.date),
    tags: post.data.tags,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const groupedByYear = new Map<number, PostMeta[]>();
posts.forEach((post) => {
  const year = post.date.getFullYear();
  if (!groupedByYear.has(year)) groupedByYear.set(year, []);
  groupedByYear.get(year)!.push(post);
});
---

<BaseLayout title="归档">
  <h1 class="text-3xl font-bold text-github-heading mb-8">文章归档</h1>

  {posts.length === 0 && (
    <div class="text-center py-16 text-github-text/50">
      <p>还没有文章</p>
    </div>
  )}

  <div class="space-y-10">
    {Array.from(groupedByYear.entries()).map(([year, yearPosts]) => (
      <section>
        <h2 class="text-xl font-semibold text-github-accent mb-4">{year}</h2>
        <div class="space-y-2">
          {yearPosts.map((post) => (
            <div class="flex items-center gap-3 py-1.5 border-b border-github-border/50 last:border-0">
              <span class="text-xs text-github-text/50 font-mono w-12 shrink-0">
                {formatDate(post.date).slice(5)}
              </span>
              <a
                href={`/posts/${post.slug}`}
                class="text-github-text hover:text-github-accent transition-colors flex-1 truncate"
              >
                {post.title}
              </a>
              <div class="flex gap-1.5 shrink-0">
                {post.tags.map((tag) => (
                  <a href={`/tags/${tag}`} class="text-xs text-github-text/50 hover:text-github-accent transition-colors">
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
